---
---

<section id="hero" class="min-h-screen flex items-center px-6 py-20">
  <div class="max-w-6xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

    <!-- Left: Terminal -->
    <div class="w-full">
      <div
        class="border border-mc-border transition-shadow duration-500 hover:shadow-glow-green"
        style="box-shadow: 4px 4px 0 var(--accent-dark), 0 0 40px var(--accent-subtle);"
      >
        <!-- Title bar -->
        <div class="flex items-center gap-2 px-4 py-2 bg-[#161616] border-b border-mc-border">
          <span class="w-3 h-3 bg-mc-red   rounded-sm"></span>
          <span class="w-3 h-3 bg-mc-yellow rounded-sm"></span>
          <span class="w-3 h-3 bg-mc-green  rounded-sm"></span>
          <span class="ml-4 font-mono text-xs text-mc-dark-gray select-none">portfolio.exe</span>
          <span class="ml-auto font-mono text-xs text-mc-dark-gray select-none">[ _ □ X ]</span>
        </div>

        <!-- Terminal body -->
        <div class="bg-[#0a0a0a] px-6 py-8 font-mono text-sm leading-relaxed">
          <div class="flex items-center gap-0 mb-1">
            <span class="text-mc-dark-gray">C:\Users\visitor</span>
            <span class="text-mc-green text-glow-green">&gt;</span>
            <span id="typed-cmd" class="text-mc-white ml-1"></span>
            <span id="cursor-type" class="inline-block w-[9px] h-[1em] bg-mc-green ml-0.5 animate-blink align-middle"></span>
          </div>

          <div id="output" class="mt-5" style="opacity:0; transform:translateY(10px);">
            <div class="mb-5">
              <div
                class="inline-block px-4 py-3 border border-mc-green transition-all duration-300 hover:shadow-glow-yellow"
                style="box-shadow: 3px 3px 0 var(--accent-dark);"
              >
                <h1 class="font-minecraft text-glow-yellow" style="line-height:1.8;">
                  <span class="block text-mc-yellow" style="font-size:clamp(0.8rem,2.5vw,1.3rem);">SIROOJUDDIN</span>
                  <span class="block text-mc-yellow" style="font-size:clamp(0.8rem,2.5vw,1.3rem);margin-top:0.3rem;">APENDI</span>
                </h1>
                <div class="mt-2 flex items-center gap-2">
                  <span class="inline-block w-2 h-2 bg-mc-green animate-blink" style="box-shadow:0 0 5px var(--accent);"></span>
                  <span class="font-mono text-mc-green text-xs text-glow-green">Frontend Developer</span>
                </div>
              </div>
            </div>

            <div class="space-y-1.5 pl-2 border-l-2 border-mc-border text-xs">
              <div class="desc-line" style="opacity:0;transform:translateX(-8px);">
                <span class="text-mc-green">&gt;</span>
                <span class="text-mc-white ml-2">3+ Years of Experience</span>
              </div>
              <div class="desc-line" style="opacity:0;transform:translateX(-8px);">
                <span class="text-mc-green">&gt;</span>
                <span class="text-mc-gray ml-2">React.js · TypeScript · Golang · Angular</span>
              </div>
              <div class="desc-line" style="opacity:0;transform:translateX(-8px);">
                <span class="text-mc-green">&gt;</span>
                <span class="text-mc-gray ml-2">Tangerang, Banten <span class="text-mc-dark-gray">// ID</span></span>
              </div>
            </div>

            <div class="mt-5" id="final-prompt" style="opacity:0;">
              <span class="text-mc-dark-gray text-xs">C:\Users\visitor</span>
              <span class="text-mc-green text-glow-green text-xs">&gt;</span>
              <span class="inline-block w-[9px] h-[1em] bg-mc-green ml-1 animate-blink align-middle" style="box-shadow:0 0 5px var(--accent);"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: tagline + CTA + stats -->
    <div id="hero-right" class="flex flex-col gap-8" style="opacity:0;transform:translateX(20px);">

      <div>
        <p class="font-minecraft text-mc-dark-gray mb-3" style="font-size:0.45rem;letter-spacing:0.15em;">// ABOUT ME</p>
        <h2 class="font-minecraft text-mc-white leading-relaxed" style="font-size:clamp(0.75rem,1.8vw,1rem);">
          Building fast,<br/>
          <span class="text-mc-green text-glow-green">clean</span> &<br/>
          <span class="text-mc-yellow text-glow-yellow">scalable</span><br/>
          web & mobile apps.
        </h2>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4 border-t border-b border-mc-border py-6">
        {[
          { value: '3+',  label: 'Years exp' },
          { value: '2',   label: 'Companies' },
          { value: '10+', label: 'Projects' },
        ].map(s => (
          <div class="text-center">
            <div class="font-minecraft text-mc-green text-glow-green" style="font-size:clamp(0.9rem,2vw,1.4rem);">{s.value}</div>
            <div class="font-mono text-mc-dark-gray text-xs mt-1">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex flex-wrap gap-3">
        <a
          href="#projects"
          class="font-mono text-xs px-5 py-2.5 bg-mc-green text-mc-bg font-bold
                 hover:shadow-glow-green transition-all duration-200
                 border border-mc-green"
        >
          VIEW PROJECTS ↓
        </a>
        <a
          href="#contact"
          class="font-mono text-xs px-5 py-2.5 text-mc-green border border-mc-green
                 hover:bg-mc-green hover:text-mc-bg transition-all duration-200"
        >
          CONTACT ME
        </a>
        <a
          href="/CV Siroojuddin Apendi.pdf"
          download="CV Siroojuddin Apendi.pdf"
          class="font-mono text-xs px-5 py-2.5 text-mc-gray border border-mc-border
                 hover:text-mc-white hover:border-mc-gray transition-all duration-200"
        >
          ↓ RESUME
        </a>
      </div>

      <!-- scroll hint -->
      <p id="scroll-hint" class="font-mono text-xs text-mc-dark-gray" style="opacity:0;">
        <span class="animate-float inline-block">▼ scroll to explore</span>
      </p>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { TextPlugin } from 'gsap/TextPlugin';
  gsap.registerPlugin(TextPlugin);

  const tl = gsap.timeline({ delay: 0.5 });

  tl
    .to('#typed-cmd', { duration: 0.6, text: { value: 'whoami', delimiter: '' }, ease: 'none' })
    .to('#cursor-type', { opacity: 0, duration: 0.1 }, '+=0.25')
    .to('#output', { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }, '+=0.1')
    .to('.desc-line', { opacity: 1, x: 0, duration: 0.18, stagger: 0.12, ease: 'none' }, '-=0.1')
    .to('#final-prompt', { opacity: 1, duration: 0.1 }, '+=0.2')
    .to('#hero-right', { opacity: 1, x: 0, duration: 0.6, ease: 'power3.out' }, '-=0.8')
    .to('#scroll-hint', { opacity: 1, duration: 0.4 }, '+=0.3');
</script>
