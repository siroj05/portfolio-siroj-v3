---
import SectionLabel from './SectionLabel.astro';

const fields = [
  { key: 'Email',    value: 'rojudin123@gmail.com',   href: 'mailto:rojudin123@gmail.com' },
  { key: 'Phone',    value: '0813-8330-4270',         href: 'tel:+6281383304270' },
  { key: 'Location', value: 'Tangerang, Banten — ID', href: null },
];
---

<section id="contact" class="relative py-24 md:py-32 px-4 sm:px-6 border-t border-line section-block overflow-hidden">
  <!-- warm spill from a lamp just out of frame -->
  <div class="absolute inset-x-0 bottom-0 h-[60%] pointer-events-none" aria-hidden="true"
       style="background: radial-gradient(ellipse 50% 60% at 85% 100%, rgb(var(--lamp) / .10), transparent 70%);"></div>

  <div class="relative max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-8 md:gap-12">
    <div><SectionLabel label="Contact" /></div>

    <div class="stagger-group">
      <h2 class="stagger-item font-serif font-normal text-ink leading-[1.05] tracking-[-0.02em]"
          style="font-size:clamp(2.4rem,6vw,4.75rem);">
        Let's build something<br /><em class="text-lamp">together.</em>
      </h2>
      <p class="stagger-item text-muted mt-6 max-w-lg leading-relaxed">
        Open for freelance projects, full-time roles, or just a conversation about tech.
      </p>

      <a href="mailto:rojudin123@gmail.com"
         class="stagger-item inline-block mt-10 font-serif text-2xl md:text-3xl text-ink link-line hover:text-lamp-soft"
         style="background-size:100% 1px;">
        rojudin123@gmail.com
      </a>

      <dl class="stagger-item mt-14 grid sm:grid-cols-3 gap-6 border-t border-line pt-6">
        {fields.map(f => (
          <div>
            <dt class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-faint">{f.key}</dt>
            <dd class="mt-2 text-ink">
              {f.href ? <a href={f.href} class="link-line hover:text-lamp-soft">{f.value}</a> : f.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <footer class="relative max-w-6xl mx-auto mt-24 pt-6 border-t border-line flex flex-wrap justify-between gap-4 font-mono text-[0.72rem] text-faint">
    <span>© 2026 Siroojuddin Apendi</span>
    <span>Built with Astro & GSAP, somewhere in Tangerang after dark.</span>
  </footer>
</section>
