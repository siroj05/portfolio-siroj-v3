---
import SectionLabel from './SectionLabel.astro';

const experiences = [
  {
    period: 'Feb 2026 – Present',
    current: true,
    company: 'PT. Teknologi Operator Prima',
    type: 'Contract · Tangerang',
    role: 'Frontend Developer',
    points: [
      'Developed mobile banking apps using Angular, Ionic, and Cordova.',
      'Contributed to mBanking Kospinus & mBanking Dana Agung.',
      'Collaborated with backend engineers, QA, and product teams.',
      'Translated Figma designs into pixel-perfect interfaces.',
    ],
  },
  {
    period: 'Jan 2023 – Jan 2026',
    current: false,
    company: 'PT. Arthamas Solusindo',
    type: 'Contract · Jakarta',
    role: 'Frontend Developer',
    points: [
      'Developed and maintained ERP web applications.',
      'Built responsive UIs with React.js, TypeScript, and Tailwind CSS.',
      'Integrated RESTful APIs with backend teams.',
      'Improved performance reducing load times significantly.',
    ],
  },
  {
    period: 'Jul 2021 – Aug 2021',
    current: false,
    company: 'Indonesian Institute of Science (LIPI)',
    type: 'Internship · Bandung',
    role: 'Frontend Developer',
    points: [
      'Built responsive UI with Vue.js for cross-device compatibility.',
      'Developed dashboard for an automated coffee roasting machine.',
      'Synced machine data to dashboard in real-time.',
    ],
  },
  {
    period: 'Aug 2020 – Sep 2021',
    current: false,
    company: 'SEA Lab – Telkom University',
    type: 'Lab Assistant · Bandung',
    role: 'Teaching Assistant',
    points: [
      'Conducted C/C++ programming classes for students.',
      'Taught HTML, CSS, and JavaScript.',
      'One-on-one mentoring and debugging sessions.',
    ],
  },
];
---

<section id="experience" class="py-24 md:py-32 px-4 sm:px-6 border-t border-line bg-night-2 section-block">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-8 md:gap-12">
    <div><SectionLabel label="Experience" /></div>

    <ol class="stagger-group relative">
      <!-- the street every stop sits on -->
      <span class="absolute left-[5px] top-2 bottom-2 w-px bg-line" aria-hidden="true"></span>

      {experiences.map(exp => (
        <li class="stagger-item relative pl-10 pb-14 last:pb-0 group">
          <span
            class:list={[
              'absolute left-0 top-[0.55rem] w-[11px] h-[11px] rounded-full border transition-colors duration-300',
              exp.current
                ? 'bg-lamp border-lamp'
                : 'bg-night-2 border-faint group-hover:border-dusk',
            ]}
            style={exp.current ? 'box-shadow:0 0 10px rgb(var(--lamp) / .9),0 0 26px rgb(var(--lamp) / .4);' : ''}
            aria-hidden="true"
          ></span>

          <div class="font-mono text-[0.72rem] tracking-wide text-faint flex flex-wrap items-center gap-3">
            {exp.period}
            {exp.current && <span class="text-lamp">— now</span>}
          </div>

          <h3 class="font-serif text-2xl md:text-[1.75rem] text-ink mt-2 leading-snug">{exp.company}</h3>
          <p class="text-sm text-muted mt-1">
            <span class="text-dusk">{exp.role}</span>
            <span class="text-faint mx-2">·</span>
            {exp.type}
          </p>

          <ul class="mt-5 space-y-2 text-muted leading-relaxed max-w-2xl">
            {exp.points.map(p => (
              <li class="flex gap-3">
                <span class="text-faint shrink-0" aria-hidden="true">–</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
