---
import SectionLabel from './SectionLabel.astro';

const groups = [
  { label: 'Languages',       items: ['JavaScript', 'TypeScript', 'Golang'] },
  { label: 'Web',             items: ['React.js', 'Next.js', 'Remix.js', 'Vue.js', 'Angular', 'Express.js', 'Node.js'] },
  { label: 'Mobile',          items: ['Ionic Framework', 'Angular', 'React Native'] },
  { label: 'Database',        items: ['MongoDB', 'MySQL', 'Firebase'] },
  { label: 'State',           items: ['Redux', 'Zustand'] },
  { label: 'Version control', items: ['Git', 'GitHub', 'GitLab'] },
];
---

<section id="skills" class="py-24 md:py-32 px-4 sm:px-6 border-t border-line section-block">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-8 md:gap-12">
    <div><SectionLabel label="Skills" /></div>

    <dl class="stagger-group">
      {groups.map(g => (
        <div class="stagger-item group grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-1 sm:gap-6 py-5 border-b border-line first:border-t">
          <dt class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-faint pt-1
                     group-hover:text-lamp transition-colors duration-300">
            {g.label}
          </dt>
          <dd class="text-lg text-ink leading-relaxed">
            {g.items.map((s, i) => (
              <span class="inline-block whitespace-nowrap mr-2">
                {s}{i < g.items.length - 1 && <span class="text-faint ml-2" aria-hidden="true">·</span>}
              </span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
