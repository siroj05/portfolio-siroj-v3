---
import SectionLabel from './SectionLabel.astro';

const projects: Array<{
  title: string;
  description: string;
  images: string[];
  repo: string | null;
  demo: string | null;
  stack: string[];
  private?: boolean;
}> = [
  {
    title: 'Soalin.id',
    description:
      'An AI platform for Indonesian primary and secondary school teachers. Generates complete exam papers with answer keys and worked explanations, aligned with Kurikulum Merdeka 2024, in minutes.',
    images: ['/projects/soalin.jpeg'],
    repo: null,
    demo: 'https://soalin.id',
    stack: ['Next.js', 'Tailwind CSS', 'Zustand', 'Framer Motion', 'Golang', 'PostgreSQL', 'ChatGPT 4o-mini', 'Midtrans'],
  },
  {
    title: 'Open Model',
    description:
      'An AI API aggregator for Indonesian developers. One API key to reach Claude, GPT, Gemini, and DeepSeek through a single endpoint. Top up credit in Rupiah and pay only for the tokens you use.',
    images: [
      '/projects/open-model/open-model-1.jpeg',
      '/projects/open-model/open-model-2.jpeg',
    ],
    repo: null,
    demo: 'https://open-model.43.157.248.30.sslip.io/dashboard',
    stack: ['Next.js', 'Tailwind CSS', 'Golang', 'PostgreSQL', 'LiteLLM', 'Docker', 'Payment Gateway (soon)'],
  },
  {
    title: 'Financial ERP System',
    description:
      'A financial ERP system developed for PT Arthamas Solusindo. Designed to manage transactions, budgeting, and generate financial reports efficiently.',
    images: [],
    private: true,
    repo: null,
    demo: null,
    stack: ['Remix.js', 'TypeScript', 'Tailwind CSS', 'Shadcn UI', 'Zustand'],
  },
  {
    title: 'Roxy Square',
    description:
      'Company profile website for Roxy Square Jakarta — a one-stop business place in West Jakarta featuring office space, retail, and training facilities.',
    images: ['/projects/roxysquare.jpeg'],
    repo: null,
    demo: 'https://roxysquarejakarta.com/',
    stack: ['React', 'Vite', 'Tailwind CSS'],
  },
  {
    title: 'Pokémon Pokédex',
    description:
      'Pokédex app powered by PokéAPI. Browse the full Pokémon list, search by name, and view detailed stats — type, abilities, base stats, and evolution chain.',
    images: [
      '/projects/pokemon/pokemon-1.jpeg',
      '/projects/pokemon/pokemon-2.jpeg',
    ],
    repo: 'https://github.com/siroj05/Pokemon-Frontend',
    demo: 'https://pokemon-siroj.netlify.app/pokemon-list',
    stack: ['Next.js', 'Tailwind CSS', 'PokéAPI'],
  },
  {
    title: 'Hoyolab Clone',
    description:
      'A Hoyolab-inspired social platform clone with user registration, login, posting, and comment features.',
    images: ['/projects/hoyolab.webp'],
    repo: 'https://github.com/siroj05/hoyolab-clone',
    demo: 'https://siroj-hoyolab-clone.netlify.app/home',
    stack: ['React', 'Vite', 'TypeScript', 'Tailwind CSS', 'Redux', 'Express.js', 'MongoDB'],
  },
];

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section id="projects" class="py-24 md:py-32 px-4 sm:px-6 border-t border-line section-block">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-8 md:gap-12 mb-14 md:mb-20">
      <div><SectionLabel label="Projects" /></div>
      <p class="font-serif text-ink leading-[1.25]" style="font-size:clamp(1.6rem,3.4vw,2.6rem);">
        Things I've built, at work and <em class="text-dusk">after hours</em>.
      </p>
    </div>

    <div class="space-y-20 md:space-y-28">
      {projects.map((p, pi) => (
        <article class="stagger-group grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

          <!-- frame -->
          <div class:list={['stagger-item lg:col-span-7 group', pi % 2 === 1 && 'lg:order-2']}>
            <div class="frame relative overflow-hidden aspect-[16/10] rounded-[4px] border border-line bg-night-3"
                 data-slideshow={pi}>
              {p.private ? (
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 text-center px-6">
                  <svg width="120" height="64" viewBox="0 0 120 64" aria-hidden="true">
                    <rect x="8"  y="18" width="30" height="46" style="fill:rgb(var(--line))" />
                    <rect x="44" y="4"  width="34" height="60" style="fill:rgb(var(--line))" />
                    <rect x="84" y="26" width="28" height="38" style="fill:rgb(var(--line))" />
                    {[0,1,2,3,4,5].map(r => [0,1,2].map(c => (
                      <rect x={51 + c * 9} y={12 + r * 8} width="4" height="5"
                            style={`fill:${r === 2 && c === 1 ? 'rgb(var(--lamp))' : 'rgb(var(--faint) / .35)'}`} />
                    )))}
                  </svg>
                  <div>
                    <div class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-muted">Client work</div>
                    <div class="text-sm text-faint mt-1">Source and preview aren't public.</div>
                  </div>
                </div>
              ) : p.images.map((src, ii) => (
                <img
                  src={src}
                  alt={`${p.title} screenshot ${ii + 1}`}
                  data-slide={ii}
                  class="absolute inset-0 w-full h-full object-cover object-top transition-[opacity,transform] duration-700 ease-out group-hover:scale-[1.02]"
                  style={ii === 0 ? 'opacity:1;' : 'opacity:0;'}
                  loading="lazy"
                />
              ))}

              {!p.private && <div class="dusk-tint absolute inset-0 pointer-events-none"></div>}

              {p.images.length > 1 && (
                <div class="absolute bottom-3 right-3 flex gap-1.5 z-10" data-dots={pi}>
                  {p.images.map((_, ii) => (
                    <span data-dot={ii}
                          class={`w-1.5 h-1.5 rounded-full transition-colors duration-300 ${ii === 0 ? 'bg-lamp' : 'bg-white/30'}`}></span>
                  ))}
                </div>
              )}
            </div>
          </div>

          <!-- text -->
          <div class:list={['stagger-item lg:col-span-5', pi % 2 === 1 && 'lg:order-1']}>
            <div class="font-serif italic text-lamp text-lg">{String(pi + 1).padStart(2, '0')}</div>
            <h3 class="font-serif text-3xl md:text-4xl text-ink mt-2 leading-tight">{p.title}</h3>
            <p class="text-muted leading-relaxed mt-4">{p.description}</p>

            <p class="font-mono text-[0.72rem] leading-relaxed text-faint mt-6">
              {p.stack.join(' / ')}
            </p>

            {(p.demo || p.repo) && (
              <div class="flex flex-wrap gap-x-6 gap-y-2 mt-6 text-sm">
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener" class="link-line text-ink hover:text-lamp-soft">
                    {host(p.demo).length > 26 ? 'Live demo' : host(p.demo)} <span aria-hidden="true">↗</span>
                  </a>
                )}
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener" class="link-line text-muted hover:text-ink">
                    Source <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}
          </div>

        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* screenshots sit in dusk light, and come to full colour on hover */
  .dusk-tint {
    background: linear-gradient(to top, rgb(var(--night) / .55), rgb(var(--dusk-deep) / .18));
    mix-blend-mode: multiply;
    transition: opacity .6s ease;
  }
  .frame:hover .dusk-tint { opacity: 0; }
  .frame { transition: border-color .4s ease, box-shadow .4s ease; }
  .frame:hover {
    border-color: rgb(var(--lamp) / .4);
    box-shadow: 0 20px 60px -20px rgb(var(--lamp) / .18);
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach(container => {
    const idx  = container.dataset.slideshow;
    const imgs = container.querySelectorAll<HTMLImageElement>('[data-slide]');
    const dots = document.querySelector(`[data-dots="${idx}"]`);
    if (imgs.length < 2 || reduce) return;

    let current = 0;
    setInterval(() => {
      imgs[current].style.opacity = '0';
      dots?.querySelector(`[data-dot="${current}"]`)?.classList.replace('bg-lamp', 'bg-white/30');
      current = (current + 1) % imgs.length;
      imgs[current].style.opacity = '1';
      dots?.querySelector(`[data-dot="${current}"]`)?.classList.replace('bg-white/30', 'bg-lamp');
    }, 3500);
  });
</script>
