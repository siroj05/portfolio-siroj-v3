---
const projects: Array<{
  title: string;
  description: string;
  images: string[];
  repo: string | null;
  demo: string | null;
  stack: string[];
  private?: boolean;
}> = [
  {
    title: 'SOALIN.ID',
    description:
      'Platform AI untuk guru SD, SMP, dan SMA Indonesia. Generate soal ujian lengkap dengan kunci jawaban & pembahasan sesuai Kurikulum Merdeka 2024 — dalam hitungan menit.',
    images: ['/projects/soalin.jpeg'],
    repo: null,
    demo: 'https://soalin.id',
    stack: ['Next.js', 'Tailwind CSS', 'Zustand', 'Framer Motion', 'Golang', 'PostgreSQL', 'ChatGPT 4o-mini', 'Midtrans'],
  },
  {
    title: 'POKÉMON POKÉDEX',
    description:
      'Pokédex app powered by PokéAPI. Browse the full Pokémon list, search by name, and view detailed stats — type, abilities, base stats, and evolution chain.',
    images: [
      '/projects/pokemon/pokemon-1.jpeg',
      '/projects/pokemon/pokemon-2.jpeg',
    ],
    repo: 'https://github.com/siroj05/Pokemon-Frontend',
    demo: 'https://pokemon-siroj.netlify.app/pokemon-list',
    stack: ['Next.js', 'Tailwind CSS', 'PokéAPI'],
  },
  {
    title: 'FINANCIAL ERP SYSTEM',
    description:
      'A financial ERP system developed for PT Arthamas Solusindo. Designed to manage transactions, budgeting, and generate financial reports efficiently.',
    images: [],
    private: true,
    repo: null,
    demo: null,
    stack: ['Remix.js', 'TypeScript', 'Tailwind CSS', 'Shadcn UI', 'Zustand'],
  },
  {
    title: 'ROXY SQUARE',
    description:
      'Company profile website for Roxy Square Jakarta — a one-stop business place in West Jakarta featuring office space, retail, and training facilities.',
    images: ['/projects/roxysquare.jpeg'],
    repo: null,
    demo: 'https://roxysquarejakarta.com/',
    stack: ['React', 'Vite', 'Tailwind CSS'],
  },
  {
    title: 'HOYOLAB CLONE',
    description:
      'A Hoyolab-inspired social platform clone with user registration, login, posting, and comment features.',
    images: ['/projects/hoyolab.webp'],
    repo: 'https://github.com/siroj05/hoyolab-clone',
    demo: 'https://siroj-hoyolab-clone.netlify.app/home',
    stack: ['React', 'Vite', 'TypeScript', 'Tailwind CSS', 'Redux', 'Express.js', 'MongoDB'],
  },
  {
    title: 'OPEN MODEL',
    description:
      'API aggregator AI untuk developer Indonesia. Satu API key untuk akses Claude, GPT, Gemini, dan DeepSeek lewat satu endpoint. Topup kredit pakai Rupiah, bayar sesuai token yang dipakai.',
    images: [
      '/projects/open-model/open-model-1.jpeg',
      '/projects/open-model/open-model-2.jpeg',
    ],
    repo: null,
    demo: 'https://open-model.43.157.248.30.sslip.io/dashboard',
    stack: ['Next.js', 'Tailwind CSS', 'Golang', 'PostgreSQL', 'LiteLLM', 'Docker', 'Payment Gateway (soon)'],
  },
];
---

<section id="projects" class="py-24 px-6 border-t border-mc-border section-block" style="background:#0a0a0a;">
  <div class="max-w-6xl mx-auto">

    <div class="section-prompt mb-10 font-mono text-xs text-mc-dark-gray">
      <span class="text-mc-green text-glow-green">▸</span>
      <span class="ml-2 uppercase tracking-widest">Projects</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 stagger-group">
      {projects.map((p, pi) => (
        <article
          class="project-card stagger-item group border border-mc-border bg-[#0d0d0d]
                 hover:border-mc-green hover:shadow-glow-green transition-all duration-300"
          style="box-shadow: 3px 3px 0 #111;"
        >
          <!-- Image / Slideshow -->
          <div class="relative overflow-hidden aspect-video bg-[#161616]" data-slideshow={pi}>
            {p.private ? (
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#0d0d0d] border-b border-mc-border">
                <div class="font-minecraft text-mc-dark-gray text-center" style="font-size:0.5rem;line-height:2;">
                  <div class="text-mc-green text-glow-green mb-2" style="font-size:0.65rem;">■</div>
                  PRIVATE PROJECT
                </div>
                <div class="font-mono text-[0.6rem] text-mc-dark-gray px-4 text-center leading-relaxed">
                  // source code & preview<br/>not publicly available
                </div>
              </div>
            ) : p.images.map((src, ii) => (
              <img
                src={src}
                alt={`${p.title} screenshot ${ii + 1}`}
                data-slide={ii}
                class="absolute inset-0 w-full h-full object-cover object-top
                       grayscale brightness-75
                       group-hover:grayscale-0 group-hover:brightness-100
                       transition-all duration-500 ease-out"
                style={ii === 0 ? 'opacity:1;' : 'opacity:0;'}
                loading="lazy"
              />
            ))}

            <!-- slide dots (only when >1 image) -->
            {p.images.length > 1 && (
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 z-10"
                   data-dots={pi}>
                {p.images.map((_, ii) => (
                  <span
                    data-dot={ii}
                    class={`w-1.5 h-1.5 rounded-full transition-colors duration-300 ${ii === 0 ? 'bg-mc-green' : 'bg-mc-dark-gray'}`}
                  ></span>
                ))}
              </div>
            )}

            <!-- overlay -->
            <div class="absolute inset-0 bg-mc-bg/40 group-hover:bg-transparent
                        transition-colors duration-500 pointer-events-none"></div>

            <!-- LIVE badge -->
            {p.demo && (
              <a
                href={p.demo}
                target="_blank"
                class="absolute top-2 right-2 font-mono text-[0.6rem] px-2 py-1
                       bg-mc-bg/80 border border-mc-green text-mc-green text-glow-green
                       opacity-0 group-hover:opacity-100 transition-opacity duration-300
                       hover:bg-mc-green hover:text-mc-bg z-10"
              >
                LIVE ↗
              </a>
            )}
          </div>

          <!-- Content -->
          <div class="p-4">
            <h3 class="font-minecraft text-mc-yellow group-hover:text-glow-yellow
                       transition-all duration-300 mb-2"
                style="font-size:0.55rem;line-height:1.8;letter-spacing:0.05em;">
              {p.title}
            </h3>

            <p class="font-mono text-mc-gray text-xs leading-relaxed mb-4">
              {p.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {p.stack.map(s => (
                <span class="font-mono text-[0.65rem] px-2 py-0.5 text-mc-white
                             border border-[#2a2a2a] bg-[#111]"
                      style="box-shadow:inset 1px 1px 0 rgba(255,255,255,0.05),inset -1px -1px 0 rgba(0,0,0,0.5);">
                  {s}
                </span>
              ))}
            </div>

            <div class="flex flex-col gap-1.5">
              {p.demo && (
                <a href={p.demo} target="_blank"
                   class="inline-flex items-center gap-1.5 font-mono text-xs
                          text-mc-dark-gray hover:text-mc-green hover:text-glow-green
                          transition-all duration-200 group/link">
                  <span class="text-mc-green group-hover/link:text-glow-green">▸</span>
                  <span>{p.demo.replace('https://', '')}</span>
                  <span class="opacity-0 group-hover/link:opacity-100 transition-opacity">↗</span>
                </a>
              )}
              {p.repo && (
                <a href={p.repo} target="_blank"
                   class="inline-flex items-center gap-1.5 font-mono text-xs
                          text-mc-dark-gray hover:text-mc-aqua
                          transition-all duration-200 group/repo">
                  <span class="text-mc-dark-gray group-hover/repo:text-mc-aqua">▸</span>
                  <span>{p.repo.replace('https://github.com/', 'github.com/')}</span>
                  <span class="opacity-0 group-hover/repo:opacity-100 transition-opacity">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  // Auto-slideshow for cards with multiple images
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach(container => {
    const idx   = Number(container.dataset.slideshow);
    const imgs  = container.querySelectorAll<HTMLImageElement>('[data-slide]');
    const dots  = document.querySelector(`[data-dots="${idx}"]`);

    if (imgs.length < 2) return;

    let current = 0;

    setInterval(() => {
      imgs[current].style.opacity = '0';
      dots?.querySelector(`[data-dot="${current}"]`)?.classList.replace('bg-mc-green', 'bg-mc-dark-gray');

      current = (current + 1) % imgs.length;

      imgs[current].style.opacity = '1';
      dots?.querySelector(`[data-dot="${current}"]`)?.classList.replace('bg-mc-dark-gray', 'bg-mc-green');
    }, 3000);
  });
</script>
