<section id="education" class="py-24 px-6 border-t border-mc-border section-block">
  <div class="max-w-6xl mx-auto">

    <div class="section-prompt mb-10 font-mono text-xs text-mc-dark-gray">
      <span class="text-mc-green text-glow-green">▸</span>
      <span class="ml-2 uppercase tracking-widest">Education</span>
    </div>

    <div class="stagger-group grid grid-cols-1 md:grid-cols-[11rem_1fr] gap-4 md:gap-8">

      <div class="stagger-item md:text-right">
        <div class="font-mono text-xs text-mc-dark-gray">Sep 2018 – Sep 2022</div>
      </div>

      <div class="stagger-item border-l-2 border-mc-border hover:border-mc-yellow transition-colors duration-300 pl-8 relative group">
        <div class="hidden md:block absolute -left-[5px] top-1.5 w-2 h-2 border-2 border-mc-yellow bg-mc-bg"></div>

        <div class="font-minecraft text-mc-yellow group-hover:text-glow-yellow transition-all mb-1"
             style="font-size:0.58rem;line-height:1.8;">
          Telkom University
        </div>
        <div class="font-mono text-xs text-mc-aqua text-glow-aqua mb-1">
          Bachelor Degree – Computer Engineering
        </div>
        <div class="font-mono text-xs text-mc-dark-gray mb-4">Bandung, Indonesia</div>

        <ul class="space-y-2 font-mono text-xs text-mc-gray">
          <li class="flex gap-2">
            <span class="text-mc-green">▸</span>
            <span>GPA <span class="text-mc-white">3.34 / 4.00</span></span>
          </li>
          <li class="flex gap-2">
            <span class="text-mc-green">▸</span>
            <span>Thesis: <span class="text-mc-white">"Deteksi Bahasa Isyarat SIBI Menggunakan Metode Single Shot Multibox Detector"</span></span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
