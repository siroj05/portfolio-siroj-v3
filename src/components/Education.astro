---
import SectionLabel from './SectionLabel.astro';
---

<section id="education" class="py-24 md:py-32 px-4 sm:px-6 border-t border-line bg-night-2 section-block">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-8 md:gap-12">
    <div><SectionLabel label="Education" /></div>

    <div class="stagger-group">
      <div class="stagger-item font-mono text-[0.72rem] tracking-wide text-faint">Sep 2018 – Sep 2022 · Bandung</div>
      <h3 class="stagger-item font-serif text-3xl md:text-4xl text-ink mt-2">Telkom University</h3>
      <p class="stagger-item text-dusk mt-1">Bachelor's Degree, Computer Engineering</p>

      <dl class="stagger-item mt-8 grid sm:grid-cols-[10rem_1fr] gap-x-6 gap-y-4 max-w-3xl">
        <dt class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-faint pt-1">GPA</dt>
        <dd class="text-ink">3.34 / 4.00</dd>
        <dt class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-faint pt-1">Thesis</dt>
        <dd class="font-serif italic text-lg text-ink leading-snug">
          “Deteksi Bahasa Isyarat SIBI Menggunakan Metode Single Shot Multibox Detector”
        </dd>
      </dl>
    </div>
  </div>
</section>
